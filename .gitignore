# ===== China OS · .gitignore =====

# 依赖（可由 package-lock.json 还原，勿入库）
node_modules/
**/node_modules/

# 构建产物
dist/
build/
**/dist/
*.tsbuildinfo

# macOS / 编辑器
.DS_Store
**/.DS_Store
*.swp
*~

# 扫描产物（可再生；基线 mojibake_baseline.json 需入库，勿忽略）
mojibake_report.json

# 日志与缓存
*.log
npm-debug.log*
.vite/
.cache/
.wrangler/

# 环境与密钥
.env
.env.*
!.env.example

# 私享模块导出（含个人财务数据，勿入库）
chinaos-personal-*.json
*personal*.export.json
personal-review-export*.json

# Python（构建脚本用）
__pycache__/
*.pyc
.venv/
venv/

# 编辑器/工具本地配置（勿入库）
.cursor/settings.json
.dash.json

# Vite 临时时间戳文件（中断的 dev 运行产物）
**/vite.config.*.timestamp-*.mjs

# 一次性审计/密度快照（transient；tracked 的 *-after/*-pass/round* 需保留）
reports/density-before.json
reports/density-after.json
reports/density-final.json
reports/freshness-audit-before.json
